{
  "name": "pi-devin-oauth",
  "version": "0.1.2",
  "description": "Devin models in Pi without the Devin CLI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "devin",
    "cognition",
    "custom-provider"
  ],
  "author": "ttttmr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttttmr/pi-devin-oauth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
